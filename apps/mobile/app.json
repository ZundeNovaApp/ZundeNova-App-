{
  "expo": {
    "name": "ZundeNova",
    "slug": "zundenova-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/zundenova-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/zundenova-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F2937"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zundenova.mobile",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/zundenova-logo.png",
        "backgroundColor": "#1F2937"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.zundenova.mobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/zundenova-logo.png"
    },
    "extra": {
      "apiUrl": "https://api.zundenova.com",
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "plugins": [
      "expo-camera",
      "expo-media-library"
    ]
  }
}
