{
  "expo": {
    "name": "ZundeNova",
    "slug": "zundenova-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/zundenova-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/zundenova-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#228B22"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zundenova.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "ZundeNova needs camera access for AI plant and livestock diagnostics",
        "NSLocationWhenInUseUsageDescription": "ZundeNova needs location access for weather data and farm mapping",
        "NSMicrophoneUsageDescription": "ZundeNova needs microphone access for voice diagnostics and expert consultations"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/zundenova-logo.png",
        "backgroundColor": "#228B22"
      },
      "package": "com.zundenova.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/zundenova-logo.png"
    },
    "extra": {
      "apiUrl": "https://zundenova-api.railway.app",
      "eas": {
        "projectId": "zundenova-mobile-app"
      }
    },
    "plugins": [
      "expo-camera",
      "expo-location",
      "@react-native-async-storage/async-storage",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#228B22"
        }
      ]
    ]
  }
}
