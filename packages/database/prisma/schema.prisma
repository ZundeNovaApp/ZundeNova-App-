generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  role          UserRole
  profileImage  String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  farms         Farm[]
  orders        Order[]  @relation("BuyerOrders")
  sales         Order[]  @relation("SellerOrders")
  products      Product[]
  consultations Consultation[]

  @@map("users")
}

model Farm {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  latitude  Float
  longitude Float
  address   String
  size      Float
  sizeUnit  String   @default("hectares")
  soilType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner     User   @relation(fields: [ownerId], references: [id])
  crops     Crop[]
  livestock Livestock[]

  @@map("farms")
}

model Crop {
  id                  String   @id @default(cuid())
  farmId              String
  name                String
  variety             String?
  plantingDate        DateTime
  expectedHarvestDate DateTime
  area                Float
  status              CropStatus
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  farm Farm @relation(fields: [farmId], references: [id])

  @@map("crops")
}

model Livestock {
  id           String          @id @default(cuid())
  farmId       String
  type         LivestockType
  breed        String?
  count        Int
  healthStatus HealthStatus
  lastCheckup  DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  farm Farm @relation(fields: [farmId], references: [id])

  @@map("livestock")
}

model Product {
  id          String            @id @default(cuid())
  name        String
  description String
  category    ProductCategory
  price       Float
  currency    String            @default("USD")
  images      String[]
  availability ProductAvailability
  sellerId    String
  rating      Float             @default(0)
  reviewCount Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  seller     User        @relation(fields: [sellerId], references: [id])
  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id              String        @id @default(cuid())
  buyerId         String
  sellerId        String
  totalAmount     Float
  currency        String        @default("USD")
  status          OrderStatus
  paymentStatus   PaymentStatus
  shippingAddress Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  buyer  User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller User        @relation("SellerOrders", fields: [sellerId], references: [id])
  items  OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float

  // Relations
  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Consultation {
  id          String             @id @default(cuid())
  farmerId    String
  expertId    String
  type        ConsultationType
  status      ConsultationStatus
  scheduledAt DateTime
  duration    Int                @default(30)
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relations
  farmer User @relation(fields: [farmerId], references: [id])

  @@map("consultations")
}

enum UserRole {
  FARMER
  VET
  PARTNER
  NGO
  INVESTOR
  ADMIN
  AGRO_DEALER
  EXPERT
}

enum CropStatus {
  PLANTED
  GROWING
  HARVESTED
  FAILED
}

enum LivestockType {
  CATTLE
  GOATS
  SHEEP
  POULTRY
  PIGS
  OTHER
}

enum HealthStatus {
  HEALTHY
  SICK
  RECOVERING
  QUARANTINED
}

enum ProductCategory {
  SEEDS
  FERTILIZERS
  PESTICIDES
  TOOLS
  FEED
  MEDICINE
  OTHER
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
  LIMITED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ConsultationType {
  VIDEO
  CHAT
  PHONE
  VISIT
}

enum ConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
